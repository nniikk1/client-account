&НаСервере
Функция КК_ПолучитьКонтрагентаПользователя() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пользователи.КК_Контрагент КАК Контрагент
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ = &Ид";

	Запрос.УстановитьПараметр("Ид",
		ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Контрагент;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции


&НаСервере
Функция КК_СоздатьИнтернетЗаказ() Экспорт

	Контрагент = КК_ПолучитьКонтрагентаПользователя();
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ВызватьИсключение "У пользователя не заполнен КК_Контрагент.";
	КонецЕсли;

	НовыйЗаказ = Документы.ЗаказПокупателя.СоздатьДокумент();
	НовыйЗаказ.Дата = ТекущаяДата();
	НовыйЗаказ.Контрагент = Контрагент;
	НовыйЗаказ.КК_ИнтернетЗаказ = Истина;
	НовыйЗаказ.КК_СтатусИнтернетЗаказа = Перечисления.КК_СтатусыИнтернетЗаказа.Черновик;

	НовыйЗаказ.Записать();

	Возврат НовыйЗаказ.Ссылка;

КонецФункции


&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ТекущийКонтрагент = КК_ПолучитьКонтрагентаПользователя();

	Если НЕ ЗначениеЗаполнено(ТекущийКонтрагент) Тогда
		Возврат;
	КонецЕсли;
	
	Если МоиЗаказы.Отбор.Контрагент <> Неопределено Тогда
		МоиЗаказы.Отбор.Контрагент.Установить(ТекущийКонтрагент);
	КонецЕсли;

	Если МоиЗаказы.Отбор.КК_ИнтернетЗаказ <> Неопределено Тогда
		МоиЗаказы.Отбор.КК_ИнтернетЗаказ.Установить(Истина);
	КонецЕсли;

КонецПроцедуры



&НаКлиенте
Процедура СоздатьЗаказ(Команда)

	НоваяСсылка = КК_СоздатьИнтернетЗаказ();

	Если Не ЗначениеЗаполнено(НоваяСсылка) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьФормуЗаказа(НоваяСсылка);
	КК_ОбновитьМоиЗаказы();

КонецПроцедуры


&НаКлиенте
Процедура МоиЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	СсылкаДокумента = Неопределено;

	Если ТипЗнч(ВыбраннаяСтрока) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		СсылкаДокумента = ВыбраннаяСтрока;
	ИначеЕсли ЗначениеЗаполнено(Ссылка) Тогда
		СсылкаДокумента = Ссылка;
	ИначеЕсли ЗначениеЗаполнено(Элементы.МоиЗаказы.ТекущиеДанные) 
		И Элементы.МоиЗаказы.ТекущиеДанные.Свойство("Ссылка") Тогда
		СсылкаДокумента = Элементы.МоиЗаказы.ТекущиеДанные.Ссылка;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;

	ОткрытьФормуЗаказа(СсылкаДокумента);

КонецПроцедуры


&НаКлиенте
Процедура ОткрытьФормуЗаказа(СсылкаДокумента)

	ПараметрыФормы = Новый Структура;
	ФормаЗаказа = ОткрытьФорму("ОбщаяФорма.КК_ФормаЗаказа", ПараметрыФормы, ЭтаФорма, Истина);

	Если ФормаЗаказа = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ФормаЗаказа.СсылкаЗаказа = СсылкаДокумента;
	ФормаЗаказа.КК_ПослеОткрытияУстановитьСсылку();

КонецПроцедуры


&НаКлиенте
Процедура КК_ОбновитьМоиЗаказы() Экспорт

	Попытка
		МоиЗаказы.Обновить();
	Исключение
	КонецПопытки;

	Если Элементы.Найти("МоиЗаказы") <> Неопределено Тогда
		Попытка
			Элементы.МоиЗаказы.Обновить();
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

