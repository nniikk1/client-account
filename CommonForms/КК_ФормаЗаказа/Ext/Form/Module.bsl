&НаКлиенте
Процедура ПриОткрытии(Отказ)

ЭтаФорма.Заголовок = "Заказ";

КонецПроцедуры


&НаКлиенте
Процедура КК_ПослеОткрытияУстановитьСсылку() Экспорт

Если Не ЗначениеЗаполнено(СсылкаЗаказа) Тогда
Закрыть();
Возврат;
КонецЕсли;

КК_ЗагрузитьИзЗаказа();

КонецПроцедуры


&НаКлиенте
Процедура КК_ЗагрузитьИзЗаказа()

ДанныеЗаказа = КК_ПрочитатьЗаказ(СсылкаЗаказа);

Если ДанныеЗаказа = Неопределено Тогда
Возврат;
КонецЕсли;

Дата = ДанныеЗаказа.Дата;
Номер = ДанныеЗаказа.Номер;
СтатусИнтернетЗаказа = ДанныеЗаказа.СтатусИнтернетЗаказа;

Товары.Очистить();

Для Каждого Стр Из ДанныеЗаказа.Товары Цикл
	НоваяСтрока = Товары.Добавить();
	НоваяСтрока.Номенклатура = Стр.Номенклатура;
	НоваяСтрока.ЕдиницаИзмерения = Стр.ЕдиницаИзмерения;
	НоваяСтрока.Количество = Стр.Количество;
	
	ЦенаРозничная = КК_ПолучитьРозничнуюЦену(СсылкаЗаказа, Стр.Номенклатура);
	Если ЗначениеЗаполнено(ЦенаРозничная) И ЦенаРозничная <> 0 Тогда
		НоваяСтрока.Цена = ЦенаРозничная;
	Иначе
		НоваяСтрока.Цена = Стр.Цена;
	КонецЕсли;
	
	НоваяСтрока.Сумма = ?(ЗначениеЗаполнено(НоваяСтрока.Количество), НоваяСтрока.Количество, 0)
		* ?(ЗначениеЗаполнено(НоваяСтрока.Цена), НоваяСтрока.Цена, 0);
КонецЦикла;

КК_ПересчитатьИтого();
КК_ОбновитьВидимостьКнопкиОформить();

Если ЗначениеЗаполнено(Номер) Тогда
ЭтаФорма.Заголовок = "Заказ № " + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy");
Иначе
ЭтаФорма.Заголовок = "Заказ";
КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура КК_ОбновитьВидимостьКнопкиОформить()

	Если ЭтаФорма.Элементы.Найти("ОформитьЗаказ") <> Неопределено Тогда
		ЭтаФорма.Элементы.ОформитьЗаказ.Visible =
			(СтатусИнтернетЗаказа = КК_СтатусЧерновик());
	КонецЕсли;
	
	Если ЭтаФорма.Элементы.Найти("Сохранить") <> Неопределено Тогда
		ЭтаФорма.Элементы.Сохранить.Visible =
			(СтатусИнтернетЗаказа = КК_СтатусЧерновик());
	КонецЕсли;
	
	Если ЭтаФорма.Элементы.Найти("ТоварыКоманднаяПанель") <> Неопределено Тогда
		ЭтаФорма.Элементы.ТоварыКоманднаяПанель.Visible =
			(СтатусИнтернетЗаказа = КК_СтатусЧерновик());
	КонецЕсли;
	
	Если ЭтаФорма.Элементы.Найти("Оплатить") <> Неопределено Тогда
		ЭтаФорма.Элементы.Оплатить.Visible =
			(СтатусИнтернетЗаказа = КК_СтатусОжидаетОплаты());
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура КК_ПересчитатьИтого()

Итого = 0;

Для Каждого Стр Из Товары Цикл
Стр.Сумма = ?(ЗначениеЗаполнено(Стр.Количество), Стр.Количество, 0)
* ?(ЗначениеЗаполнено(Стр.Цена), Стр.Цена, 0);
Итого = Итого + Стр.Сумма;
КонецЦикла;

КонецПроцедуры


&НаКлиенте
Процедура Сохранить(Команда)

Если Не ЗначениеЗаполнено(СсылкаЗаказа) Тогда
Возврат;
КонецЕсли;

КК_ПересчитатьИтого();

ТоварыДляЗаписи = Новый Массив;

Для Каждого Стр Из Товары Цикл
НоваяСтрока = Новый Структура;
НоваяСтрока.Вставить("Номенклатура", Стр.Номенклатура);
НоваяСтрока.Вставить("ЕдиницаИзмерения", Стр.ЕдиницаИзмерения);
НоваяСтрока.Вставить("Количество", Стр.Количество);
НоваяСтрока.Вставить("Цена", Стр.Цена);
ТоварыДляЗаписи.Добавить(НоваяСтрока);
КонецЦикла;

КК_ЗаписатьЗаказ(СсылкаЗаказа, ТоварыДляЗаписи);
ЭтаФорма.Модифицированность = Ложь;

КонецПроцедуры


&НаКлиенте
Процедура ОформитьЗаказ(Команда)

	Если Не ЗначениеЗаполнено(СсылкаЗаказа) Тогда
		Возврат;
	КонецЕсли;
	
	КК_УстановитьСтатусЗаказа(СсылкаЗаказа, КК_СтатусВОбработке());
	СтатусИнтернетЗаказа = КК_СтатусВОбработке();
	КК_ОбновитьВидимостьКнопкиОформить();
	ЭтаФорма.Модифицированность = Ложь;
	ФормаМоиЗаказы = ОткрытьФорму("Обработка.КК_РабочееМестоКонтрагента.Форма.ФормаМоиЗаказы");
	Если ФормаМоиЗаказы <> Неопределено Тогда
		ФормаМоиЗаказы.КК_ОбновитьМоиЗаказы();
	КонецЕсли;
	Закрыть();

КонецПроцедуры


&НаКлиенте
Процедура Оплатить(Команда)

	Если Не ЗначениеЗаполнено(СсылкаЗаказа) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтатусИнтернетЗаказа <> КК_СтатусОжидаетОплаты() Тогда
		Возврат;
	КонецЕсли;
	
	КК_УстановитьСтатусЗаказа(СсылкаЗаказа, КК_СтатусИсполняется());
	СтатусИнтернетЗаказа = КК_СтатусИсполняется();
	КК_ОбновитьВидимостьКнопкиОформить();
	ЭтаФорма.Модифицированность = Ложь;
	
	КК_ОткрытьПечатнуюФормуСчета();

КонецПроцедуры


&НаСервере
Функция КК_СтатусЧерновик()
	Возврат Перечисления.КК_СтатусыИнтернетЗаказа.Черновик;
КонецФункции


&НаСервере
Функция КК_СтатусВОбработке()
	Возврат Перечисления.КК_СтатусыИнтернетЗаказа.ВОбработке;
КонецФункции


&НаСервере
Функция КК_СтатусОжидаетОплаты()
	Возврат Перечисления.КК_СтатусыИнтернетЗаказа.ОжидаетОплаты;
КонецФункции


&НаСервере
Функция КК_СтатусИсполняется()
	Возврат Перечисления.КК_СтатусыИнтернетЗаказа.Исполняется;
КонецФункции


&НаКлиентеПроцедура КК_ОткрытьПечатнуюФормуСчета()	Если Не ЗначениеЗаполнено(СсылкаЗаказа) Тогда		Возврат;	КонецЕсли;	МассивОбъектов = Новый Массив;	МассивОбъектов.Добавить(СсылкаЗаказа);	ИдентификаторКоманды = КК_ПолучитьИдентификаторСчета();	ИменаМакетов = Новый Массив;	ИменаМакетов.Добавить(ИдентификаторКоманды);	ПараметрыПечати = Новый Структура;	ПараметрыПечати.Вставить("ИдентификаторКоманды", ИдентификаторКоманды);	ПараметрыПечати.Вставить("ПараметрКоманды",      МассивОбъектов);	ПараметрыПечати.Вставить("ИменаМакетов",         ИменаМакетов);	ПараметрыПечати.Вставить("ИмяМенеджераПечати",   "Документ.ЗаказПокупателя");	ОткрытьФорму(		"ОбщаяФорма.ПечатьДокументов",		ПараметрыПечати,		ЭтаФорма);КонецПроцедуры&НаСервереФункция КК_ПолучитьИдентификаторСчета()	Возврат Обработки.ПечатьСчетНаОплату.ИдентификаторПечатнойФормы(Ложь, Ложь);КонецФункции
&НаКлиенте                                   

Процедура ТоварыКоличествоПриИзменении(Элемент)

	ТекущаяСтрока = КК_ПолучитьТекущуюСтрокуТоваров();
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КК_ПересчитатьСуммуСтроки(ТекущаяСтрока);
	КК_ОбновитьТаблицуТоваров();
	КК_ПересчитатьИтого();

КонецПроцедуры


&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	ТекущаяСтрока = КК_ПолучитьТекущуюСтрокуТоваров();
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КК_ПересчитатьСуммуСтроки(ТекущаяСтрока);
	КК_ОбновитьТаблицуТоваров();
	КК_ПересчитатьИтого();

КонецПроцедуры


&НаКлиенте
Процедура ТоварыНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СтандартнаяОбработка = Истина;
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = КК_ПолучитьТекущуюСтрокуТоваров();
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КК_ПрименитьНоменклатуруКСтроке(ТекущаяСтрока, ВыбранноеЗначение);
	КК_ПересчитатьИтого();
	КК_ОбновитьТаблицуТоваров();

КонецПроцедуры


&НаКлиенте
Процедура ТоварыНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("ОбщаяФорма.КК_КаталогТоваров", Новый Структура("РежимВыбора", Истина), Элемент);

КонецПроцедуры


&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)

	Номенклатура = Неопределено;
	Попытка
		Номенклатура = Элемент.Значение;
	Исключение
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		ТекущаяСтрока = КК_ПолучитьТекущуюСтрокуТоваров();
		Если ТекущаяСтрока <> Неопределено Тогда
			Номенклатура = ТекущаяСтрока.Номенклатура;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = КК_ПолучитьТекущуюСтрокуТоваров();
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КК_ПрименитьНоменклатуруКСтроке(ТекущаяСтрока, Номенклатура);
	КК_ПересчитатьИтого();
	КК_ОбновитьТаблицуТоваров();

КонецПроцедуры


&НаКлиенте
Функция КК_ПолучитьТекущуюСтрокуТоваров()

	ЭлементТовары = ЭтаФорма.Элементы.Найти("Товары");
	Если ЭлементТовары = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ТекущаяСтрока = ЭлементТовары.ТекущиеДанные;
	Исключение
		ТекущаяСтрока = Неопределено;
	КонецПопытки;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		Возврат ТекущаяСтрока;
	КонецЕсли;
	
	Попытка
		ИндексСтроки = ЭлементТовары.ТекущаяСтрока;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(ИндексСтроки) = Тип("Число")
		И ИндексСтроки >= 0
		И ИндексСтроки < Товары.Количество() Тогда
		Возврат Товары[ИндексСтроки];
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции


&НаКлиенте
Процедура КК_ПересчитатьСуммуСтроки(СтрокаТовара)

	СтрокаТовара.Сумма = ?(ЗначениеЗаполнено(СтрокаТовара.Количество), СтрокаТовара.Количество, 0)
		* ?(ЗначениеЗаполнено(СтрокаТовара.Цена), СтрокаТовара.Цена, 0);

КонецПроцедуры


&НаКлиенте
Процедура КК_ПрименитьНоменклатуруКСтроке(СтрокаТовара, Номенклатура)

	Цена = КК_ПолучитьРозничнуюЦену(СсылкаЗаказа, Номенклатура);
	Если ЗначениеЗаполнено(Цена) Тогда
		СтрокаТовара.Цена = Цена;
	КонецЕсли;
	
	ЕдиницаИзмерения = КК_ПолучитьЕдиницуНоменклатуры(Номенклатура);
	Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		СтрокаТовара.ЕдиницаИзмерения = ЕдиницаИзмерения;
	КонецЕсли;
	
	КК_ПересчитатьСуммуСтроки(СтрокаТовара);

КонецПроцедуры


&НаКлиенте
Процедура КК_ОбновитьТаблицуТоваров()

	ЭлементТовары = ЭтаФорма.Элементы.Найти("Товары");
	Если ЭлементТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЭлементТовары.ОбновитьТекущуюСтроку();
	Исключение
		ЭлементТовары.Обновить();
	КонецПопытки;

КонецПроцедуры


&НаСервере
Функция КК_ПрочитатьЗаказ(СсылкаЗаказа) Экспорт

Если Не ЗначениеЗаполнено(СсылкаЗаказа) Тогда
Возврат Неопределено;
КонецЕсли;

ОбъектЗаказа = СсылкаЗаказа.ПолучитьОбъект();

Данные = Новый Структура;
Данные.Вставить("Дата", ОбъектЗаказа.Дата);
Данные.Вставить("Номер", ОбъектЗаказа.Номер);
Данные.Вставить("СтатусИнтернетЗаказа", ОбъектЗаказа.КК_СтатусИнтернетЗаказа);

МассивТоваров = Новый Массив;

Для Каждого СтрЗапасы Из ОбъектЗаказа.Запасы Цикл
СтрокаТовара = Новый Структура;
СтрокаТовара.Вставить("Номенклатура", СтрЗапасы.Номенклатура);
СтрокаТовара.Вставить("ЕдиницаИзмерения", СтрЗапасы.ЕдиницаИзмерения);
СтрокаТовара.Вставить("Количество", СтрЗапасы.Количество);
СтрокаТовара.Вставить("Цена", СтрЗапасы.Цена);
МассивТоваров.Добавить(СтрокаТовара);
КонецЦикла;

Данные.Вставить("Товары", МассивТоваров);

Возврат Данные;

КонецФункции


&НаСервере
Функция КК_ПолучитьРозничнуюЦену(СсылкаЗаказа, Номенклатура) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат 0;
	КонецЕсли;
	
	ДатаДокумента = ТекущаяДата();
	Если ЗначениеЗаполнено(СсылкаЗаказа) Тогда
		ДатаДокумента = СсылкаЗаказа.ПолучитьОбъект().Дата;
	КонецЕсли;
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти("ЦеныНоменклатуры");
	Если МетаданныеРегистра = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Отбор = Новый Структура("Номенклатура", Номенклатура);
	Если МетаданныеРегистра.Измерения.Найти("ВидЦены") <> Неопределено
		И Метаданные.Справочники.Найти("ВидыЦен") <> Неопределено Тогда
		ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная");
		Если Не ЗначениеЗаполнено(ВидЦены) Тогда
			ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная цена");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			Отбор.Вставить("ВидЦены", ВидЦены);
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияРесурсов = РегистрыСведений.ЦеныНоменклатуры.ПолучитьПоследнее(ДатаДокумента, Отбор);
	
	Если ЗначенияРесурсов <> Неопределено И ЗначенияРесурсов.Свойство("Цена") Тогда
		Возврат ЗначенияРесурсов.Цена;
	КонецЕсли;
	
	Возврат 0;

КонецФункции


&НаСервере
Функция КК_ПолучитьЕдиницуНоменклатуры(Номенклатура) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ОбъектНоменклатуры = Номенклатура.ПолучитьОбъект();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Попытка
		Возврат ОбъектНоменклатуры.ЕдиницаИзмерения;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;

КонецФункции


&НаСервере
Процедура КК_ЗаписатьЗаказ(СсылкаНаСервере, ТоварыФормы) Экспорт

Если Не ЗначениеЗаполнено(СсылкаНаСервере) Тогда
ВызватьИсключение "Не заполнена ссылка на заказ.";
КонецЕсли;

ЗаказОбъект = СсылкаНаСервере.ПолучитьОбъект();

ЗаказОбъект.Запасы.Очистить();

Для Каждого СтрФормы Из ТоварыФормы Цикл
Если Не ЗначениеЗаполнено(СтрФормы.Номенклатура) Тогда
Продолжить;
КонецЕсли;

НоваяСтрока = ЗаказОбъект.Запасы.Добавить();
НоваяСтрока.Номенклатура = СтрФормы.Номенклатура;
Если ЗначениеЗаполнено(СтрФормы.ЕдиницаИзмерения) Тогда
	НоваяСтрока.ЕдиницаИзмерения = СтрФормы.ЕдиницаИзмерения;
Иначе
	НоваяСтрока.ЕдиницаИзмерения = КК_ПолучитьЕдиницуНоменклатуры(СтрФормы.Номенклатура);
КонецЕсли;
НоваяСтрока.Количество = ?(ЗначениеЗаполнено(СтрФормы.Количество), СтрФормы.Количество, 1);
НоваяСтрока.Цена = ?(ЗначениеЗаполнено(СтрФормы.Цена), СтрФормы.Цена, 0);
КонецЦикла;

ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры


&НаСервере
Процедура КК_УстановитьСтатусЗаказа(СсылкаНаСервере, НовыйСтатус) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаНаСервере) Тогда
		ВызватьИсключение "Не заполнена ссылка на заказ.";
	КонецЕсли;
	
	ЗаказОбъект = СсылкаНаСервере.ПолучитьОбъект();
	ЗаказОбъект.КК_СтатусИнтернетЗаказа = НовыйСтатус;
	ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры
