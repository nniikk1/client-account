&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьКаталог();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКаталог()
	
	Каталог.Очистить();
	
	ВидЦеныРозничный = КК_НайтиВидЦеныРозничный();
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Тов.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(Тов.Артикул, """") КАК Артикул,
	|	Тов.Наименование КАК Наименование,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена
	|ИЗ
	|	Справочник.Номенклатура КАК Тов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, &УсловиеЦены) КАК Цены
	|		ПО Цены.Номенклатура = Тов.Ссылка
	|ГДЕ
	|	НЕ Тов.ПометкаУдаления
	|	И НЕ Тов.ЭтоГруппа
	|УПОРЯДОЧИТЬ ПО
	|	Тов.Наименование";
	
	// Если найден вид цены «Розничная» — фильтруем срез по нему,
	// иначе берём срез без фильтра, чтобы Цена хотя бы что-то показала.
	Если ЗначениеЗаполнено(ВидЦеныРозничный) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеЦены", "ВидЦены = &ВидЦены");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеЦены", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Если ЗначениеЗаполнено(ВидЦеныРозничный) Тогда
		Запрос.УстановитьПараметр("ВидЦены", ВидЦеныРозничный);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Каталог.Добавить();
		НоваяСтрока.Ссылка       = Выборка.Ссылка;
		НоваяСтрока.Артикул      = Выборка.Артикул;
		НоваяСтрока.Наименование = Выборка.Наименование;
		НоваяСтрока.Цена         = Выборка.Цена;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция КК_НайтиВидЦеныРозничный()
	
	Если Метаданные.Справочники.Найти("ВидыЦен") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная");
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная цена");
	КонецЕсли;
	
	Возврат ВидЦены;
	
КонецФункции

&НаКлиенте
Процедура КаталогВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ВернутьВыборТекущейСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	ВернутьВыборТекущейСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьВыборТекущейСтроки()
	
	ТекущиеДанные = Элементы.Каталог.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(ТекущиеДанные.Ссылка);
	
КонецПроцедуры
