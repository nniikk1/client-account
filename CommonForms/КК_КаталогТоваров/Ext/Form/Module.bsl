&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимВыбора = Параметры.Свойство("РежимВыбора") И Параметры.РежимВыбора;
	ЭтаФорма.РежимВыбораЗначения = РежимВыбора;
	Элементы.Выбрать.Видимость = РежимВыбора;
	
	ЗаполнитьГруппы();
	ЗаполнитьКаталог(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГруппы()
	
	ДеревоГрупп = РеквизитФормыВЗначение("Группы");
	ДеревоГрупп.Строки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Гр.Ссылка КАК Ссылка,
	|	Гр.Наименование КАК Наименование,
	|	Гр.Родитель КАК Родитель
	|ИЗ
	|	Справочник.Номенклатура КАК Гр
	|ГДЕ
	|	Гр.ЭтоГруппа
	|	И НЕ Гр.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Гр.Наименование";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	КартаСтрок = Новый Соответствие;
	Осталось = Таблица.Количество();
	БезопасныйСчётчик = Осталось * 2 + 1;
	
	Пока Осталось > 0 И БезопасныйСчётчик > 0 Цикл
		БезопасныйСчётчик = БезопасныйСчётчик - 1;
		Изменилось = Ложь;
		Для Каждого Стр Из Таблица Цикл
			Если КартаСтрок.Получить(Стр.Ссылка) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Стр.Родитель) И КартаСтрок.Получить(Стр.Родитель) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Стр.Родитель) Тогда
				СтрокиРодителя = КартаСтрок.Получить(Стр.Родитель).Строки;
			Иначе
				СтрокиРодителя = ДеревоГрупп.Строки;
			КонецЕсли;
			
			НоваяСтрока = СтрокиРодителя.Добавить();
			НоваяСтрока.Ссылка = Стр.Ссылка;
			НоваяСтрока.Наименование = Стр.Наименование;
			КартаСтрок.Вставить(Стр.Ссылка, НоваяСтрока);
			
			Осталось = Осталось - 1;
			Изменилось = Истина;
		КонецЦикла;
		Если Не Изменилось Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоГрупп, "Группы");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКаталог(ГруппаОтбор)
	
	Каталог.Очистить();
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Тов.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(Тов.Артикул, """") КАК Артикул,
	|	Тов.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Тов
	|ГДЕ
	|	НЕ Тов.ПометкаУдаления
	|	И НЕ Тов.ЭтоГруппа";
	
	Если ЗначениеЗаполнено(ГруппаОтбор) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И Тов.Ссылка В ИЕРАРХИИ (&Группа)";
		Запрос.УстановитьПараметр("Группа", ГруппаОтбор);
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|УПОРЯДОЧИТЬ ПО
	|	Тов.Наименование";
	
	Запрос.Текст = ТекстЗапроса;
	
	ВидЦеныРозничный = КК_НайтиВидЦеныРозничный();
	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти("ЦеныНоменклатуры");
	ИмяИзмеренияВидЦены = ?(МетаданныеРегистра <> Неопределено
		И МетаданныеРегистра.Измерения.Найти("ВидЦены") <> Неопределено,
		"ВидЦены", "");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Каталог.Добавить();
		НоваяСтрока.Ссылка       = Выборка.Ссылка;
		НоваяСтрока.Артикул      = Выборка.Артикул;
		НоваяСтрока.Наименование = Выборка.Наименование;
		НоваяСтрока.Цена         = ПолучитьЦенуТовара(Выборка.Ссылка,
			ВидЦеныРозничный, ИмяИзмеренияВидЦены, МетаданныеРегистра);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуТовара(Номенклатура, ВидЦены, ИмяИзмеренияВидЦены, МетаданныеРегистра)
	
	Если МетаданныеРегистра = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Отбор = Новый Структура("Номенклатура", Номенклатура);
	Если ЗначениеЗаполнено(ИмяИзмеренияВидЦены) И ЗначениеЗаполнено(ВидЦены) Тогда
		Отбор.Вставить(ИмяИзмеренияВидЦены, ВидЦены);
	КонецЕсли;
	
	ЗначенияРесурсов = РегистрыСведений.ЦеныНоменклатуры.ПолучитьПоследнее(, Отбор);
	Если ЗначенияРесурсов <> Неопределено И ЗначенияРесурсов.Свойство("Цена") Тогда
		Возврат ЗначенияРесурсов.Цена;
	КонецЕсли;
	Возврат 0;
	
КонецФункции

&НаСервере
Функция КК_НайтиВидЦеныРозничный()
	
	Если Метаданные.Справочники.Найти("ВидыЦен") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная");
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Розничная цена");
	КонецЕсли;
	
	Возврат ВидЦены;
	
КонецФункции

&НаКлиенте
Процедура КаталогВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Не РежимВыбораЗначения Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ВернутьВыборТекущейСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	ВернутьВыборТекущейСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьВыборТекущейСтроки()
	
	ТекущиеДанные = Элементы.Каталог.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(ТекущиеДанные.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыПриАктивизацииСтроки(Элемент)
	
	ИдентификаторСтроки = Элементы.Группы.ТекущаяСтрока;
	Если ИдентификаторСтроки = Неопределено Тогда
		ОбновитьКаталогНаСервере(Неопределено);
		Возврат;
	КонецЕсли;
	
	СтрокаДерева = Группы.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаДерева = Неопределено Тогда
		ОбновитьКаталогНаСервере(Неопределено);
		Возврат;
	КонецЕсли;
	
	ОбновитьКаталогНаСервере(СтрокаДерева.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКаталогНаСервере(Группа)
	
	ЗаполнитьКаталог(Группа);
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьФильтр(Команда)
	
	Элементы.Группы.ТекущаяСтрока = Неопределено;
	ОбновитьКаталогНаСервере(Неопределено);
	
КонецПроцедуры
