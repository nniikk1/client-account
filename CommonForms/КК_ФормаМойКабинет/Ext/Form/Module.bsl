&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьДанныеКонтрагента();
	
КонецПроцедуры

&НаСервере
Функция КК_ПолучитьКонтрагентаПользователя()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пользователи.КК_Контрагент КАК Контрагент
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ = &Ид";

	Запрос.УстановитьПараметр("Ид",
		ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Контрагент;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеКонтрагента()
	
	ВсегоЗаказов  = 0;
	ОжидаетОплаты = "0 ₽";
	ВРаботе       = 0;
	
	ТекКонтрагент = КК_ПолучитьКонтрагентаПользователя();
	
	Если НЕ ЗначениеЗаполнено(ТекКонтрагент) Тогда
		Контрагент = "Добро пожаловать, гость!";
		Возврат;
	КонецЕсли;
	
	Контрагент = "Добро пожаловать, " + ТекКонтрагент.Наименование + "!";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Заказ.Ссылка) КАК ВсегоЗаказов,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|			КОГДА Заказ.КК_СтатусИнтернетЗаказа = ЗНАЧЕНИЕ(Перечисление.КК_СтатусыИнтернетЗаказа.ОжидаетОплаты)
	|				ТОГДА Заказ.СуммаДокумента
	|			ИНАЧЕ 0
	|		КОНЕЦ), 0) КАК СуммаОжидаетОплаты,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|			КОГДА Заказ.КК_СтатусИнтернетЗаказа В (
	|				ЗНАЧЕНИЕ(Перечисление.КК_СтатусыИнтернетЗаказа.ВОбработке),
	|				ЗНАЧЕНИЕ(Перечисление.КК_СтатусыИнтернетЗаказа.ОжидаетОплаты),
	|				ЗНАЧЕНИЕ(Перечисление.КК_СтатусыИнтернетЗаказа.Исполняется),
	|				ЗНАЧЕНИЕ(Перечисление.КК_СтатусыИнтернетЗаказа.Выполнен))
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ), 0) КАК ВРаботе
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказ
	|ГДЕ
	|	Заказ.Контрагент = &Контрагент
	|	И Заказ.КК_ИнтернетЗаказ = ИСТИНА";
	
	Запрос.УстановитьПараметр("Контрагент", ТекКонтрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВсегоЗаказов  = Выборка.ВсегоЗаказов;
		ОжидаетОплаты = Формат(Выборка.СуммаОжидаетОплаты, "ЧДЦ=2; ЧРГ=' '") + " ₽";
		ВРаботе       = Выборка.ВРаботе;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьМоиЗаказы(Команда)
	
	ОткрытьФорму("Обработка.КК_РабочееМестоКонтрагента.Форма.ФормаМоиЗаказы");
	
КонецПроцедуры
