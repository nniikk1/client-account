&После("ПередЗаписью")Процедура КК_ПередЗаписью_УстановитьСтатус(Отказ, РежимЗаписи, РежимПроведения)	Если Не КК_ИнтернетЗаказ Тогда		Возврат;	КонецЕсли;	Если РежимЗаписи = РежимЗаписиДокумента.Проведение		И КК_СтатусИнтернетЗаказа = Перечисления.КК_СтатусыИнтернетЗаказа.ВОбработке Тогда		КК_СтатусИнтернетЗаказа = Перечисления.КК_СтатусыИнтернетЗаказа.ОжидаетОплаты;		Возврат;	КонецЕсли;	Если Не ЗначениеЗаполнено(Ссылка) Тогда		Возврат;	КонецЕсли;	СостояниеСтрокой = СокрЛП(СостояниеЗаказа);	Если СостояниеСтрокой = "На складе"		И КК_СтатусИнтернетЗаказа <> Перечисления.КК_СтатусыИнтернетЗаказа.Закрыт Тогда		КК_СтатусИнтернетЗаказа = Перечисления.КК_СтатусыИнтернетЗаказа.Выполнен;	ИначеЕсли СостояниеСтрокой = "Завершен" Тогда		КК_СтатусИнтернетЗаказа = Перечисления.КК_СтатусыИнтернетЗаказа.Закрыт;	КонецЕсли;КонецПроцедуры